# Dockerfile for Linux build
# Usage: docker build -f Dockerfile.linux -o dist --build-arg VERSION=x.x.x .

FROM golang:1.26-bookworm AS builder

# Build arguments for version injection
ARG VERSION=dev
ARG BUILD_TIME=unknown

WORKDIR /app

# Install libpcap + ebiten's native deps (cached layer) - cmd/radar imports internal/overlay
# (ebiten, for -overlay) unconditionally at compile time even though the overlay is a Windows-
# only feature at runtime; X11/ALSA dev headers are required just to get past cgo import, not to
# actually run it.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      libpcap-dev \
      gcc pkg-config \
      libgl1-mesa-dev libglu1-mesa-dev \
      xorg-dev libxcursor-dev libxi-dev libxinerama-dev libxrandr-dev libxxf86vm-dev \
      libasound2-dev && \
    rm -rf /var/lib/apt/lists/*

# Copy and cache dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build with version info
COPY . .
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w -X main.Version=${VERSION} -X main.BuildTime=${BUILD_TIME}" \
    -o /out/OpenRadar-linux-amd64 ./cmd/radar

# Export binary only
FROM scratch
COPY --from=builder /out/OpenRadar-linux-amd64 /
