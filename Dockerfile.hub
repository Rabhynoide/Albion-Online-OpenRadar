# Dockerfile for the OpenRadar Hub
# Usage: docker build -f Dockerfile.hub -t openradar-hub .

FROM golang:1.26-bookworm AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -o /out/hub ./cmd/hub

FROM gcr.io/distroless/static-debian12
COPY --from=builder /out/hub /hub
VOLUME /data
EXPOSE 8090
ENTRYPOINT ["/hub"]
